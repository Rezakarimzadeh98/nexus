  "components": {
    "schemas": {
      "DetectJobRequest": {
        "properties": {
          "limit": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 500
          },
          "velocity_threshold": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Velocity Threshold",
            "default": 1.5
          },
          "min_short_volume": {
            "type": "number",
            "minimum": 0.0,
            "title": "Min Short Volume",
            "default": 2.0
          }
        },
        "type": "object",
        "title": "DetectJobRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestJobRequest": {
        "properties": {
          "adapter": {
            "type": "string",
            "title": "Adapter",
            "default": "generic"
          },
          "offline": {
            "type": "boolean",
            "title": "Offline",
            "description": "Use sources.ci.yaml fixtures",
            "default": true
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": true
          },
          "fixture_root": {
            "type": "string",
            "title": "Fixture Root",
            "default": "datasets"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          }
        },
        "type": "object",
        "title": "IngestJobRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
