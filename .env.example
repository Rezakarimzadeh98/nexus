# Copy to repo root as `.env` for local development.
NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# NEXUS_REDIS_URL=redis://localhost:6379/0
# Required for write paths in staging/production:
# NEXUS_API_KEY=replace-me
# NEXUS_SNAPSHOT_PATH=docs/live/status.json
